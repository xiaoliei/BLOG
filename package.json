{
  "name": "blog-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "world:generate": "tsx scripts/world-generate.ts",
    "world:validate": "tsx scripts/world-validate.ts",
    "test:world": "node --import tsx --test scripts/world.test.ts scripts/grid-world.test.ts scripts/entry-flight.test.ts scripts/local-time.test.ts scripts/api.test.ts",
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit && tsc -p worker --noEmit",
    "build": "npm run typecheck && tsx scripts/copy-vditor.ts && vite build",
    "preview": "vite preview",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply blog-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply blog-db --remote",
    "seed": "tsx scripts/seed.ts",
    "seed:remote": "tsx scripts/seed.ts --remote",
    "dev:worker": "wrangler dev",
    "deploy": "npm run build && npm run db:migrate:remote && wrangler deploy"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.185.1",
    "vditor": "^3.11.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260816.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.0.5",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "wrangler": "^4.123.0"
  }
}
