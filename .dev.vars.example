# 复制为 .dev.vars（已被 .gitignore 忽略），供 wrangler dev 本地使用
# 配置约定：运行环境变量统一走环境变量，不进 git（本模板除外）
# 生产环境在 Cloudflare 后台 Worker → Settings → Variables and Secrets 配置同名变量

# ---------- 本地开发 ----------
# 本地开发令牌：设置后可通过 `X-Admin-Token` 头访问 /api/admin/*（仅本地回退用）
ADMIN_DEV_TOKEN=dev-token-change-me

# ---------- Cloudflare Access（P2） ----------
# 本地不经过 Access 时可留空；为空时 admin API 依赖 ADMIN_DEV_TOKEN
# 生产：后台 Variables 添加 ACCESS_TEAM_DOMAIN（如 xiaoli）与 ACCESS_AUD
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=

# ---------- R2（P4） ----------
# 图片存储走 Worker 原生 binding（IMAGES），无需环境变量
